# --- Required ---------------------------------------------------------
# Free GeoNames account username: https://www.geonames.org/login
# You must also enable "free web services" for the account at
# https://www.geonames.org/manageaccount
GEONAMES_USERNAME=

# --- Optional -----------------------------------------------------------
# MongoDB connection string. Required for /api/kundli/generate's `userId`
# linking + PATCH updates, for the entire /api/chat/* Chat API (birth-Kundli
# lookup + credit tracking), and for everything under /api/admin/*. Without
# it, /generate and /transit still work fully, just without persistence.
MONGODB_URI=mongodb://localhost:27017/astromitra_kundli

# --- AI provider keys: ONE-TIME MIGRATION BOOTSTRAP ONLY -----------------
# As of the admin panel update, AI provider keys are managed via the admin
# API and stored ENCRYPTED IN MONGODB — never in this file going forward.
# GEMINI_API_KEY / GROQ_API_KEY below exist only so that if you're
# upgrading from before this change, the server can migrate your existing
# key into an encrypted DB record automatically on first startup (see the
# "[aiProviderKey.service] Migrated ..." log line). Once you see that log
# line, DELETE the corresponding line below — it is no longer read after
# that point. For a fresh setup, leave both blank and add keys via
# POST /api/admin/ai-keys instead (see README).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Provider base URLs — not secrets, normally leave as-is.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Encryption (required for /api/admin/ai-keys and for the chat AI ------
# --- pipeline to decrypt stored keys before calling a provider) ----------
# Any passphrase works (it's stretched via SHA-256 internally) but should
# be long, random, and backed up somewhere safe — losing it makes every
# encrypted key in MongoDB permanently unreadable (you'd need to delete and
# re-add them). Generate one with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Admin panel authentication (required for all /api/admin/* except -----
# --- the login route itself) ---------------------------------------------
ADMIN_EMAIL=
# Bcrypt hash of the admin password — NEVER put the plaintext password
# here. Generate a hash with:
#   npm run hash-admin-password -- "your-password-here"
ADMIN_PASSWORD_HASH=
# Any long random string; generate with: openssl rand -hex 32
JWT_SECRET=
# How long an admin login session stays valid.
ADMIN_JWT_EXPIRES_IN=12h

# Server port
PORT=3000

# development | production
NODE_ENV=development

# Comma-free single origin, or "*" for any origin (default: *)
CORS_ORIGIN=*

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=60

# GeoNames API base URL - use the https paid tier host if you have one;
# the free tier is http-only.
GEONAMES_BASE_URL=http://api.geonames.org
